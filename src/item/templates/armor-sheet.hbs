<div class="sheet-root flexcol">

    {{!-- Item Sheet Header --}}
    {{> "systems/fvtt-yze-generic-stepped/templates/item/parts/item-header.hbs"}}

    {{!-- Sheet Tab Navigation --}}
    <nav class="sheet-tabs tabs slanted-tabs flexrow" data-group="primary">
        <a class="item" data-action="tab" data-group="primary" data-tab="features">{{localize "YZEGS.ItemSheet.FeaturesTab"}}</a>
        <a class="item" data-action="tab" data-group="primary" data-tab="modifiers">{{localize "YZEGS.ItemSheet.ModifiersTab"}}</a>
        <a class="item" data-action="tab" data-group="primary" data-tab="description">{{localize "YZEGS.ItemSheet.DescriptionTab"}}</a>
    </nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{!-- Features Tab --}}
        <div class="tab tab-features" data-group="primary" data-tab="features">
            <div class="grid grid-3col item-features">
                <div class="flexcol">
                    <label>{{localize "YZEGS.ItemSheet.Armor"}}</label>
                    <div class="flexrow">
                        <input type="text" name="system.rating.value" value="{{system.rating.value}}" data-dtype="Number"/>
                        <span class="sep">/</span>
                        <input type="text" name="system.rating.max" value="{{system.rating.max}}" data-dtype="Number"/>
                    </div>
                </div>
                <div class="flexcol">
                    <label>{{localize "YZEGS.ItemSheet.Weight"}}</label>
                    <input type="text" name="system.weight" value="{{numberFormat system.weight decimals=2}}" data-dtype="Number"/>
                </div>
                <div class="flexcol">
                    <label>{{localize "YZEGS.ItemSheet.Price"}}</label>
                    <input type="text" name="system.price" value="{{system.price}}" data-dtype="Number"/>
                </div>
            </div>

            {{!-- Other Parameters --}}
            <div class="features-other flexcol">

                {{!-- Properties --}}
				<label>{{localize "YZEGS.ItemSheet.ArmorLocation"}}</label>
                <div class="form-group-stacked item-properties">
                    <label class="checkbox">
                        {{> checkboxControl name="system.location.head" value=system.location.head editable=@root.editable}}
                        {{localize "YZEGS.ArmorLocationNames.head"}}
                    </label>
                    <label class="checkbox">
                        {{> checkboxControl name="system.location.torso" value=system.location.torso editable=@root.editable}}
                        {{localize "YZEGS.ArmorLocationNames.torso"}}
                    </label>
                    <label class="checkbox">
                        {{> checkboxControl name="system.location.arms" value=system.location.arms editable=@root.editable}}
                        {{localize "YZEGS.ArmorLocationNames.arms"}}
                    </label>
                    <label class="checkbox">
                        {{> checkboxControl name="system.location.legs" value=system.location.legs editable=@root.editable}}
                        {{localize "YZEGS.ArmorLocationNames.legs"}}
                    </label>
                </div>

            </div>

            {{!-- Inventory Options --}}
            {{#if inActor}}
            <div class="features-other flexcol">
                <div class="form-group">
                    <label class="checkbox">
                        {{> checkboxControl name="system.equipped" value=system.equipped editable=@root.editable}}
                        {{localize "YZEGS.ItemSheet.Equipped"}}
                    </label>
                </div>
                <div class="form-group">
                    <label class="checkbox">
                        {{> checkboxControl name="system.backpack" value=system.backpack editable=@root.editable}}
                        {{localize "YZEGS.ItemSheet.StoredInBackpack"}}
                    </label>
                </div>
            </div>
            {{/if}}

        </div>

        {{!-- Modifiers Tab --}}
        <div class="tab tab-modifiers" data-group="primary" data-tab="modifiers">
            {{> "systems/fvtt-yze-generic-stepped/templates/item/parts/item-modifiers.hbs"}}
        </div>

        {{!-- Description Tab --}}
        <div class="tab tab-description" data-group="primary" data-tab="description">
            {{> "systems/fvtt-yze-generic-stepped/templates/item/parts/item-description.hbs"}}
        </div>

    </section>

</div>
