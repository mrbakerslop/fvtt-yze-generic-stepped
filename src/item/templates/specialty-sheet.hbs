<div class="sheet-root flexcol">

  {{!-- Item Sheet Header --}}
  {{> "systems/fvtt-yze-generic-stepped/templates/item/parts/item-header.hbs"}}

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs slanted-tabs flexrow flex-center" data-group="primary">
    <a class="item" data-action="tab" data-group="primary" data-tab="modifiers">{{localize "YZEGS.ItemSheet.ModifiersTab"}}</a>
    <a class="item" data-action="tab" data-group="primary" data-tab="description">{{localize "YZEGS.ItemSheet.DescriptionTab"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Modifiers Tab --}}
    <div class="tab tab-modifiers" data-group="primary" data-tab="modifiers">
      {{> "systems/fvtt-yze-generic-stepped/templates/item/parts/item-modifiers.hbs"}}
    </div>

    {{!-- Description Tab --}}
    <div class="tab tab-description" data-group="primary" data-tab="description">
      {{> "systems/fvtt-yze-generic-stepped/templates/item/parts/item-description.hbs"}}
    </div>

  </section>

</div>
