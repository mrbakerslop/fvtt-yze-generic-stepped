<div class='dice-infos'>

  {{! MYZ & FBL — Attributes and Gear damage }}
  {{#if (or (eq roll.game 'myz') (eq roll.game 'fbl'))}}
    {{#if roll.pushed}}
      {{#if roll.attributeTrauma}}
        <div class='dice-info roll-trauma'>
          <span class='label'>{{localize 'YZUR.CHAT.ROLL.Trauma'}}</span>
          <span class='result'>{{roll.attributeTrauma}}</span>
        </div>
      {{/if}}
      {{#if roll.gearDamage}}
        <div class='dice-info roll-gear-damage'>
          <span class='label'>{{localize 'YZUR.CHAT.ROLL.GearDamage'}}</span>
          <span class='result'>{{roll.gearDamage}}</span>
        </div>
      {{/if}}
    {{/if}}
  {{/if}}

  {{! YEAR ZERO ENGINE - GENERIC STEPPED DICE }}
  {{#if (eq roll.game 'yzegs')}}
    {{! YZEGS: Coolness Under Fire result and consequences }}
    {{#if (eq roll.options.checkType 'cuf')}}
      <div class='dice-info roll-cuf-result'>
        <span class='label'>{{localize 'YZEGS.CuF.Result'}}</span>
        <span class='result'>
          {{#if (gt roll.baseSuccessQty 0)}}
            <span class='cuf-success'>{{localize 'YZEGS.CuF.Success'}}</span>
          {{else}}
            <span class='cuf-failure'>{{localize 'YZEGS.CuF.Failure'}}</span>
            <br />{{localize 'YZEGS.CuF.FailureEffects'}}
            <br />{{localize 'YZEGS.CuF.PanicSpreads'}}
            {{#if roll.options.suppression.effectsApplied}}
              <br /><span class='cuf-effects-applied'>{{localize 'YZEGS.Suppression.EffectsApplied'}}</span>
              {{#if roll.options.suppression.panicCount}}
                <br />{{localize 'YZEGS.Suppression.PanicChecksAdded'
                  count=roll.options.suppression.panicCount}}
              {{/if}}
            {{/if}}
          {{/if}}
        </span>
      </div>
    {{/if}}

    {{! YZEGS: Selected combat action }}
    {{#if roll.options.combatAction}}
      <div class="dice-info roll-combat-action">
        <span class="label">{{localize 'YZEGS.CombatModifiers.SelectedAction'}}</span>
        <span class="result">
          {{roll.options.combatAction.label}} ({{roll.options.combatAction.speedLabel}})
          {{#if roll.options.combatAction.value}}{{roll.options.combatAction.displayValue}}{{/if}}
          {{#if roll.options.combatAction.tracked}}
            <br />{{localize 'YZEGS.CombatActions.Spent'
              action=roll.options.combatAction.spentFromLabel
              fast=roll.options.combatAction.remaining.fast slow=roll.options.combatAction.remaining.slow}}
          {{/if}}
          {{#unless roll.options.situationalModifiers.length}}
            <br />{{localize 'YZEGS.CombatModifiers.FinalModifier'}} {{roll.options.signedModifier}}
          {{/unless}}
        </span>
      </div>
    {{/if}}

    {{! YZEGS: Action launcher context }}
    {{#if roll.options.actionData}}
      <div class="dice-info roll-action-workflow">
        <span class="label">{{localize 'YZEGS.CombatActions.Action'}}</span>
        <span class="result">
          {{roll.options.actionData.label}}
          {{#if roll.options.actionData.targetName}}<br />{{localize 'YZEGS.CombatActions.Target'}}: {{roll.options.actionData.targetName}}{{/if}}
          {{#if roll.options.actionData.itemName}}<br />{{localize 'YZEGS.CombatActions.Item'}}: {{roll.options.actionData.itemName}}{{/if}}
          {{#if roll.options.actionData.applied}}<br />{{localize 'YZEGS.CombatActions.OutcomeApplied'}}{{/if}}
        </span>
      </div>
    {{/if}}

    {{#if roll.options.actionData.tacticalMovement}}
      <div class="dice-info roll-tactical-movement">
        <span class="label">{{localize "YZEGS.TacticalTerrain.MovementAllowance"}}</span>
        <span class="result">
          {{localize "YZEGS.TacticalTerrain.Hexes"
            count=(tacticalMovementHexes roll)}}
          — {{localize (concat "YZEGS.TacticalTerrain.Modes." (tacticalMovementMode roll))}}
          <br />{{roll.options.actionData.tacticalMovement.terrain.label}}
          {{#if roll.options.actionData.tacticalMovement.terrain.elevated}}
            — {{localize "YZEGS.TacticalTerrain.Elevated"}}
          {{/if}}
        </span>
      </div>
    {{/if}}

    {{! YZEGS: Selected situational combat modifiers }}
    {{#if roll.options.situationalModifiers.length}}
      <div class="dice-info roll-situational-modifiers">
        <span class="label">{{localize 'YZEGS.CombatModifiers.Selected'}}</span>
        <span class="result">
          {{#each roll.options.situationalModifiers as |modifier|}}
            {{modifier.label}} {{modifier.displayValue}}{{#unless @last}}<br />{{/unless}}
          {{/each}}
          <br />{{localize 'YZEGS.CombatModifiers.FinalModifier'}} {{roll.options.signedModifier}}
        </span>
      </div>
    {{/if}}

    {{#if roll.options.attackData.rangeBand}}
      <div class="dice-info roll-range-band">
        <span class="label">{{localize "YZEGS.CombatEdges.Range"}}</span>
        <span class="result">{{localize (concat "YZEGS.CombatEdges.RangeBands."
          roll.options.attackData.rangeBand)}}</span>
      </div>
    {{/if}}
    {{#if (eq roll.options.actionData.workflow "breakFree")}}
      <div class="dice-info roll-opposed-resistance">
        <span class="label">{{localize "YZEGS.CombatEdges.BreakFreeResistance"
          actor=roll.options.actionData.opposedTargetName}}</span>
        <span class="result">{{roll.options.actionData.passiveSuccesses}}</span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.shotgunDamageReduction}}
      <div class="dice-info roll-shotgun-falloff">
        <span class="label">{{localize "YZEGS.CombatEdges.ShotgunFalloff"}}</span>
        <span class="result">−{{roll.options.attackData.shotgunDamageReduction}}
          {{localize "YZEGS.CombatEdges.Damage"}}</span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.firedOneHanded}}
      <div class="dice-info roll-one-handed">
        <span class="label">{{localize "YZEGS.CombatEdges.OneHanded"}}</span>
        <span class="result"><i class="fas fa-check"></i></span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.machineGunAgility}}
      <div class="dice-info roll-supported-machine-gun">
        <span class="label">{{localize "YZEGS.CombatEdges.MachineGunAttribute"}}</span>
        <span class="result">{{localize "YZEGS.AttributeNames.agl"}}</span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.targetPoint}}
      <div class="dice-info roll-heavy-target">
        <span class="label">{{localize "YZEGS.Heavy.Target"}}</span>
        <span class="result">{{localize (concat "YZEGS.Heavy.TargetModes." roll.options.attackData.targetMode)}}</span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.indirectFire}}
      <div class="dice-info roll-indirect-fire">
        <span class="label">{{localize "YZEGS.Heavy.IndirectFire.Label"}}</span>
        <span class="result">
          {{#if roll.options.attackData.automaticDeviation}}
            {{localize "YZEGS.Heavy.IndirectFire.Unobserved"}}
          {{else}}
            {{localize "YZEGS.Heavy.IndirectFire.Observed"}}
          {{/if}}
        </span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.correctionBonus}}
      <div class="dice-info roll-artillery-correction">
        <span class="label">{{localize "YZEGS.Heavy.Modifiers.Correction"}}</span>
        <span class="result">+{{roll.options.attackData.correctionBonus}}</span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.deviation.resolved}}
      <div class="dice-info roll-deviation">
        <span class="label">{{localize "YZEGS.Heavy.Deviation.Label"}}</span>
        <span class="result">{{localize (concat "YZEGS.Heavy.Deviation.Directions."
          roll.options.attackData.deviation.direction)}} — {{roll.options.attackData.deviation.distance}}</span>
      </div>
    {{/if}}
    {{#if roll.options.attackData.fireControlRange}}
      <div class="dice-info roll-fire-control-range">
        <span class="label">{{localize "YZEGS.LandVehicle.FireControl.Range"}}</span>
        <span class="result">{{localize "YZEGS.LandVehicle.FireControl.ShortRange"}}</span>
      </div>
    {{/if}}

    {{! YZEGS: Hit Location }}
    {{#if roll.options.attackData.calledVehicleComponent}}
      <div class='dice-info roll-hit-location'>
        <span class='label'>{{localize 'YZEGS.LandVehicle.CalledShot.Label'}}</span>
        <span class='result'>{{localize (concat 'YZEGS.LandVehicle.Components.'
          roll.options.attackData.calledVehicleComponent)}}</span>
      </div>
    {{else if (or roll.options.attackData.calledLocation roll.options.attackData.forcedLocation)}}
      <div class='dice-info roll-hit-location'>
        <span class='label'>{{localize 'YZUR.CHAT.ROLL.HitLocation'}}</span>
        <span class='result'>
          {{#if roll.options.attackData.calledLocation}}
            {{hitLocationLabel roll.options.attackData.calledLocation}}
          {{else}}
            {{hitLocationLabel roll.options.attackData.forcedLocation}}
          {{/if}}
        </span>
      </div>
    {{else if roll.bestHitLocation}}
      <div class='dice-info roll-hit-location'>
        {{#if (gt (lookup roll.hitLocations 'length') 1)}}
          <span class='label'>{{localize 'YZUR.CHAT.ROLL.HitLocations'}}</span>
        {{else}}
          <span class='label'>{{localize 'YZUR.CHAT.ROLL.HitLocation'}}</span>
        {{/if}}
        {{#each roll.hitLocations as |loc|}}
          <span class='result'>{{hitLocationLabel loc}}</span>
        {{/each}}
      </div>
    {{/if}}

    {{! YZEGS: Extra Hits }}
    {{#if roll.hitCount}}
      <div class='dice-info roll-hit-count'>
        {{#if (gt roll.baseSuccessQty 0)}}
          <span class='label'>{{#if (gt roll.hitCount 1)}}{{localize 'YZUR.CHAT.ROLL.ExtraHits'}}{{else}}{{localize
                'YZUR.CHAT.ROLL.ExtraHit'
              }}{{/if}}</span>
        {{else}}
          <span class='label'>{{localize 'YZUR.CHAT.ROLL.Suppression'}}</span>
        {{/if}}
        <span class='result'>{{roll.hitCount}}</span>
      </div>
    {{/if}}

    {{! YZEGS: Push Damage, Stress, and Reliability }}
    {{#if roll.options.hasPushCosts}}
      <div class='dice-info roll-push-costs'>
        <span class='label'>{{localize 'YZEGS.PushCosts.Label'}}</span>
        <span class='result'>
          {{#each roll.options.pushCosts as |cost|}}
            {{localize cost.label}}: {{cost.amount}}{{#if cost.targetName}} — {{cost.targetName}}{{/if}}
            {{#if cost.applied}}
              <span class='push-cost-status applied'>{{localize 'YZEGS.PushCosts.Applied'}}</span>
            {{else}}
              {{#unless cost.canApply}}
                <span class='push-cost-status manual'>{{localize 'YZEGS.PushCosts.Manual'}}</span>
              {{/unless}}
            {{/if}}
            {{#unless @last}}<br />{{/unless}}
          {{/each}}
        </span>
      </div>
    {{/if}}

    {{! YZEGS: Ammo Spent }}
    {{#if roll.ammoSpent}}
      <div class='dice-info roll-ammo-spent'>
        <span class='label'>{{localize 'YZUR.CHAT.ROLL.AmmoSpent'}}</span>
        <span class='result'>{{add roll.ammoSpent 0}}</span>
      </div>

    {{/if}}

    {{! YZEGS: Jamming can be caused by base and/or ammo dice. }}
    {{#if roll.options.weaponJammed}}
      <div class='dice-info roll-jammed'>
        <span class='label'>{{localize 'YZUR.CHAT.ROLL.Jammed'}}</span>
      </div>
    {{/if}}

  {{/if}}

  {{! Mishap }}
  {{!-- {{#if roll.mishap}} --}}
  {{!-- <div class="dice-info">{{localize "YZUR.CHAT.ROLL.Mishap"}}</div> --}}
  {{!-- {{/if}} --}}

</div>
