<div class="yzegs chat-card weapon" data-item-id="{{id}}" data-owner-id="{{owner}}" data-actor-id="{{actorId}}"{{#if tokenId}} data-token-id="{{tokenId}}"{{/if}}>
  <div class="card-content">

    <div class="card-name">
      <h2>{{name}}</h2>
    </div>

    <div class="card-image">
      <img src="{{img}}" alt="{{name}}"/>
    </div>

    <div class="card-description">
      {{{system.description}}}
      {{!-- <h4>{{localize "YZEGS.ItemSheet.FeaturesTab"}}</h4> --}}
      <div class="grid grid-3col">
        {{#if system.rof}}
        <div><b>{{localize "YZEGS.ItemSheet.RoF"}}:</b> <code>{{system.rof}}</code></div>
        {{/if}}
        <div><b>{{localize "YZEGS.ItemSheet.Damage"}}:</b> <code>{{system.effectiveAttack.damage}}</code></div>
        <div><b>{{localize "YZEGS.ItemSheet.Crit"}}:</b> <code>{{system.effectiveAttack.crit}}</code></div>
        <div><b>{{localize "YZEGS.ItemSheet.Armor"}}:</b> <code>{{#if (gte system.effectiveAttack.armorModifier 1)}}+{{/if}}{{system.effectiveAttack.armorModifier}}</code></div>
        {{#if system.effectiveAttack.range}}
        <div><b>{{localize "YZEGS.ItemSheet.Range"}}:</b> <code>{{system.effectiveAttack.range}}</code></div>
        {{/if}}
        {{#unless (eq system.effectiveAttack.blast "–")}}
        <div><b>{{localize "YZEGS.ItemSheet.Blast"}}:</b> <code>{{system.effectiveAttack.blast}}</code></div>
        {{/unless}}
      </div>
    </div>

    <div class="card-buttons">
      {{#if system.jammed}}
      <p class="weapon-jammed-status"><strong>{{localize "YZEGS.Jam.Status"}}</strong></p>
      {{/if}}
      {{#unless system.isMounted}}
      {{#unless system.jammed}}
      <button class="weapon-attack" data-action="attack">{{{@root.config.Icons.buttons.attack}}} {{localize "YZEGS.Chat.Actions.Attack"}}</button>
      {{/unless}}
      {{/unless}}
      {{#if canClearJam}}
      <button class="weapon-clear-jam" data-action="clearJam">{{{@root.config.Icons.buttons.clearJam}}} {{localize "YZEGS.ActionNames.clearJam"}}</button>
      {{/if}}
      {{#if canReload}}
      <button class="weapon-reload" data-action="reload">{{{@root.config.Icons.buttons.reload}}} {{localize "YZEGS.Chat.Actions.Reload"}}</button>
      {{/if}}
    </div>

  </div>
</div>
