<div class='social-response-dialog'>
  <p><strong>{{data.stakes}}</strong></p>
  {{#if data.offer}}<p>{{localize 'YZEGS.Social.Offer'}}: {{data.offer}}</p>{{/if}}
  <div class='form-group stacked'>
    <label>{{data.label}}</label>
    <textarea name='details' rows='3'>{{data.details}}</textarea>
  </div>
</div>