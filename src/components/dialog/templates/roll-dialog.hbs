<div class='yzegs dialog roll-dialog'>

  {{! ================================================== }}

  {{#if (or data.attribute data.skill)}}
    {{! Roll Formula }}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.Formula'}}</label>
      <input type='text' name='formula' value='{{data.formula}}' disabled />
    </div>

  {{else}}
    {{! Attribute }}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.Attribute'}}</label>
      <div class='flexrow'><range-picker name='attribute' value={{mathMax 6 data.attribute}} min=0 max=12 step=2 /></div>
    </div>

    {{! Skill }}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.Skill'}}</label>
      <div class='flexrow'><range-picker name='skill' value={{mathMax 6 data.skill}} min=0 max=12 step=2 /></div>
    </div>
  {{/if}}

  {{! ================================================== }}

  {{! Rate of Fire }}
  {{#if data.rof}}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.RoF'}}</label>
      <div class='flexrow'><range-picker name='rof' value=0 min=0 max='{{data.rof}}' step=1 /></div>
    </div>
  {{/if}}

  {{! ================================================== }}

  <hr />

  {{! Combat Action and Situational Modifiers }}
  {{#if (or data.combatActionGroups.length data.combatModifierGroups.length)}}
    <div class="combat-modifier-groups combat-modifier-groups-{{data.combatType}}">
      <h3>{{data.actionHeading}}</h3>

      {{#if data.combatActionGroups.length}}
        {{#if data.tracksCombatActions}}
          <p class="combat-action-remaining">
            {{localize 'YZEGS.CombatActions.Remaining'
              fast=data.trackedActions.fast slow=data.trackedActions.slow}}
          </p>
        {{/if}}
        <div class="form-group combat-action-selector">
          <label for="yzegs-combat-action">{{localize 'YZEGS.CombatModifiers.Action'}}</label>
          {{> dialogActionMenu name="combatAction" selected=data.selectedCombatActionId
            selectedLabel=data.selectedCombatActionLabel groups=data.combatActionGroups
            placeholder=(localize 'YZEGS.CombatModifiers.NoAction') editable=true
            blankDisabled=data.tracksCombatActions inputClass="combat-action-input"}}
        </div>

        {{#if data.actionTargets.length}}
          <div class="form-group action-dialog-target" hidden>
            <label for="yzegs-roll-action-target">{{localize "YZEGS.CombatActions.Target"}}</label>
            {{> dialogChoiceMenu name="targetUuid" selected="" choices=data.actionTargets
              placeholder=(localize "YZEGS.CombatActions.NoTarget") editable=true}}
          </div>
        {{/if}}

        <div class="form-group action-dialog-item" hidden>
          <label for="yzegs-roll-action-item">{{localize "YZEGS.CombatActions.Item"}}</label>
          {{> dialogChoiceMenu name="itemId" selected="" choices=data.actionItems
            placeholder=(localize "YZEGS.CombatActions.NoItem") editable=true}}
        </div>

        <p class="hint action-dialog-hint" hidden></p>
      {{/if}}

      {{#each data.combatModifierGroups as |group|}}
        <fieldset class="combat-modifier-group combat-modifier-group-{{group.id}}">
          <legend>{{group.name}}</legend>
          <div class="combat-modifier-options">
            {{#each group.modifiers as |modifier|}}
              <label class="checkbox combat-modifier-option" title="{{modifier.name}}">
                {{> checkboxControl value=false editable=true inputClass='item-modifier situational-modifier'
                  dataValue=modifier.value dataModifierId=modifier.id dataLabel=modifier.name
                  dataExclusiveGroup=modifier.exclusiveGroup
                  ariaLabel=modifier.name}}
                <span class="combat-modifier-name">{{modifier.name}}</span>
                <span class="combat-modifier-value">{{modifier.displayValue}}</span>
              </label>
            {{/each}}
          </div>
        </fieldset>
      {{/each}}

      {{#if data.automaticModifiers.length}}
        <fieldset class="combat-modifier-group combat-modifier-group-automatic">
          <legend>{{localize "YZEGS.CombatEdges.AutomaticModifiers"}}</legend>
          <div class="combat-modifier-options automatic-combat-modifiers">
            {{#each data.automaticModifiers as |modifier|}}
              <span class="combat-modifier-option automatic-combat-modifier">
                <span class="combat-modifier-name">{{modifier.label}}</span>
                <span class="combat-modifier-value">{{modifier.displayValue}}</span>
              </span>
            {{/each}}
          </div>
        </fieldset>
      {{/if}}
    </div>

    <hr />
  {{/if}}

  {{#if data.canChooseHitLocation}}
    <div class="form-group combat-called-location">
      <label>{{data.calledLocationLabel}}</label>
      {{> optionMenu name="calledLocation" selected="" options=data.hitLocationChoices editable=true
        localize=true menuClass="dialog-option-menu"}}
    </div>
  {{/if}}

  {{#if data.oneHanded.allowed}}
    <div class="form-group combat-one-handed">
      <label>{{localize "YZEGS.CombatEdges.OneHanded"}}</label>
      <input type="hidden" name="oneHanded" value="false" />
      {{> checkboxControl name="oneHanded" value=false editable=true inputClass="one-handed-toggle"
        dataValue=data.oneHanded.modifier ariaLabel=(localize "YZEGS.CombatEdges.OneHanded")}}
    </div>
  {{/if}}

  {{#if data.indirectFireAllowed}}
    <div class="form-group combat-indirect-fire">
      <label>{{localize "YZEGS.Heavy.IndirectFire.Label"}}</label>
      <input type="hidden" name="indirectFire" value="false" />
      {{> checkboxControl name="indirectFire" value=false editable=true
        ariaLabel=(localize "YZEGS.Heavy.IndirectFire.Label")}}
    </div>
    <p class="notes">{{localize "YZEGS.Heavy.IndirectFire.Hint"}}</p>
  {{/if}}

  {{! Modifier }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.Modifier'}}</label>
    <div class='flexrow'>
      <div class='flexrow flex1 modifier-buttons'>
        <a class='button modifier-change' data-target='modifier' data-change='plus'>{{{config.Icons.buttons.plus}}}</a>
        <a
          class='button modifier-change'
          data-target='modifier'
          data-change='minus'
        >{{{config.Icons.buttons.minus}}}</a>
      </div>
      <input
        type='text'
        class='flex2'
        name='modifier'
        value='{{numberFormat data.modifier sign=true}}'
        data-dtype='Number'
      />
    </div>
  </div>

  {{! Modifiers }}
  <div class='form-group-stacked actor-roll-modifiers'>
    {{#each data.modifiers}}
      <label class='checkbox{{#if contextualActionModifier}} contextual-action-modifier{{/if}}'
        title='{{description}}' data-action-ids='{{contextualActionIds}}'
        data-default-active='{{contextualDefaultActive}}' {{#if contextualActionModifier}}hidden{{/if}}>
        {{#if contextualActionModifier}}
          {{> checkboxControl value=false editable=true inputClass='item-modifier contextual-action-modifier-toggle'
            dataValue=value ariaLabel=label}}
        {{else}}
          {{> checkboxControl value=active editable=true inputClass='item-modifier'
            dataValue=value ariaLabel=label}}
        {{/if}}
        {{label}}
      </label>
    {{/each}}
  </div>

  {{! ================================================== }}

  <hr />

  {{! Max Pushes }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.MaxPush'}}</label>
    <input type='number' name='maxPush' value='{{data.maxPush}}' min='0' data-dtype='Number'
      {{#if data.lockMaxPush}}disabled{{/if}} />
  </div>

  {{! ================================================== }}

  {{! Location Die }}
  <div class='form-group'>
    <label for='yzegs-roll-locate'>{{localize 'YZEGS.Dialog.Roll.Locate'}}</label>
    <input type='hidden' name='locate' value='{{data.locate}}' />
    {{> checkboxControl id='yzegs-roll-locate' name='locate' value=data.locate editable=true
      ariaLabel=(localize 'YZEGS.Dialog.Roll.Locate')}}
  </div>

  {{! ================================================== }}

  <hr />

  {{! Roll Mode }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.RollMode'}}</label>
    {{> optionMenu name="messageMode" selected=data.messageMode options=config.messageModes
      editable=(not data.lockMessageMode) noBlank=true localize=true menuClass="dialog-option-menu"}}
  </div>

</div>
