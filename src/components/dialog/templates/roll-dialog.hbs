<div class='yzegs dialog roll-dialog'>

  {{! ================================================== }}

  {{#if (or data.attribute data.skill)}}
    {{! Roll Formula }}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.Formula'}}</label>
      <input type='text' name='formula' value='{{data.formula}}' disabled />
    </div>

  {{else}}
    {{! Attribute }}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.Attribute'}}</label>
      <div class='flexrow'><range-picker name='attribute' value={{mathMax 6 data.attribute}} min=0 max=12 step=2 /></div>
    </div>

    {{! Skill }}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.Skill'}}</label>
      <div class='flexrow'><range-picker name='skill' value={{mathMax 6 data.skill}} min=0 max=12 step=2 /></div>
    </div>
  {{/if}}

  {{! ================================================== }}

  {{! Rate of Fire }}
  {{#if data.rof}}
    <div class='form-group'>
      <label>{{localize 'YZEGS.Dialog.Roll.RoF'}}</label>
      <div class='flexrow'><range-picker name='rof' value=0 min=0 max='{{data.rof}}' step=1 /></div>
    </div>
  {{/if}}

  {{! ================================================== }}

  <hr />

  {{! Combat Action and Situational Modifiers }}
  {{#if (or data.combatActionGroups.length data.combatModifierGroups.length)}}
    <div class="combat-modifier-groups combat-modifier-groups-{{data.combatType}}">
      <h3>{{localize (concat 'YZEGS.CombatModifiers.CombatTypes.' data.combatType)}}</h3>

      {{#if data.combatActionGroups.length}}
        <div class="form-group combat-action-selector">
          <label for="yzegs-combat-action">{{localize 'YZEGS.CombatModifiers.Action'}}</label>
          <select id="yzegs-combat-action" name="combatAction">
            <option value="" data-value="0">{{localize 'YZEGS.CombatModifiers.NoAction'}}</option>
            {{#each data.combatActionGroups as |group|}}
              <optgroup label="{{group.name}}">
                {{#each group.actions as |action|}}
                  <option value="{{action.id}}" data-value="{{action.value}}" data-label="{{action.name}}"
                    data-action-speed="{{action.group}}" data-action-speed-label="{{action.speedName}}">
                    {{action.name}}{{#if action.value}} ({{action.displayValue}}){{/if}}
                  </option>
                {{/each}}
              </optgroup>
            {{/each}}
          </select>
        </div>
      {{/if}}

      {{#each data.combatModifierGroups as |group|}}
        <fieldset class="combat-modifier-group combat-modifier-group-{{group.id}}">
          <legend>{{group.name}}</legend>
          <div class="combat-modifier-options">
            {{#each group.modifiers as |modifier|}}
              <label class="checkbox combat-modifier-option" title="{{modifier.name}}">
                {{> checkboxControl value=false editable=true inputClass='item-modifier situational-modifier'
                  dataValue=modifier.value dataModifierId=modifier.id dataLabel=modifier.name
                  dataExclusiveGroup=modifier.exclusiveGroup
                  ariaLabel=modifier.name}}
                <span class="combat-modifier-name">{{modifier.name}}</span>
                <span class="combat-modifier-value">{{modifier.displayValue}}</span>
              </label>
            {{/each}}
          </div>
        </fieldset>
      {{/each}}
    </div>

    <hr />
  {{/if}}

  {{! Modifier }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.Modifier'}}</label>
    <div class='flexrow'>
      <div class='flexrow flex1 modifier-buttons'>
        <a class='button modifier-change' data-target='modifier' data-change='plus'>{{{config.Icons.buttons.plus}}}</a>
        <a
          class='button modifier-change'
          data-target='modifier'
          data-change='minus'
        >{{{config.Icons.buttons.minus}}}</a>
      </div>
      <input
        type='text'
        class='flex2'
        name='modifier'
        value='{{numberFormat data.modifier sign=true}}'
        data-dtype='Number'
      />
    </div>
  </div>

  {{! Modifiers }}
  <div class='form-group-stacked actor-roll-modifiers'>
    {{#each data.modifiers}}
      <label class='checkbox' title='{{description}}'>
        {{> checkboxControl value=active editable=true inputClass='item-modifier'
          dataValue=value ariaLabel=label}}
        {{label}}
      </label>
    {{/each}}
  </div>

  {{! ================================================== }}

  <hr />

  {{! Max Pushes }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.MaxPush'}}</label>
    <input type='number' name='maxPush' value='{{data.maxPush}}' min='0' data-dtype='Number' />
  </div>

  {{! ================================================== }}

  {{! Location Die }}
  <div class='form-group'>
    <label for='yzegs-roll-locate'>{{localize 'YZEGS.Dialog.Roll.Locate'}}</label>
    <input type='hidden' name='locate' value='{{data.locate}}' />
    {{> checkboxControl id='yzegs-roll-locate' name='locate' value=data.locate editable=true
      ariaLabel=(localize 'YZEGS.Dialog.Roll.Locate')}}
  </div>

  {{! ================================================== }}

  <hr />

  {{! Roll Mode }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.RollMode'}}</label>
    <select name='messageMode'>
      {{selectOptions config.messageModes selected=data.messageMode localize=true}}
    </select>
  </div>

</div>
