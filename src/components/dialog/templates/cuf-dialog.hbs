<div class='yzegs dialog cuf-dialog'>

  {{! ================================================== }}

  {{! Unit Morale }}
  <div class='form-group'>
    <label for='yzegs-cuf-unit-morale'>{{localize 'YZEGS.Dialog.CuF.UnitMorale'}}</label>
    <input type='hidden' name='unitMorale' value='{{data.unitMorale}}' />
    {{> checkboxControl id='yzegs-cuf-unit-morale' name='unitMorale' value=data.unitMorale editable=true
      ariaLabel=(localize 'YZEGS.Dialog.CuF.UnitMorale')}}
  </div>

  <hr />

  {{! Modifier }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.Modifier'}}</label>
    <div class='flexrow'>
      <div class='flexrow flex1 modifier-buttons'>
        <a class='button modifier-change' data-target='modifier' data-change='plus'>{{{config.Icons.buttons.plus}}}</a>
        <a
          class='button modifier-change'
          data-target='modifier'
          data-change='minus'
        >{{{config.Icons.buttons.minus}}}</a>
      </div>
      <input
        type='text'
        class='flex2'
        name='modifier'
        value='{{numberFormat data.modifier sign=true}}'
        data-dtype='Number'
      />
      {{!-- <button class="btn choose-modifier">{{localize "YZEGS.Dialog.Roll.ModifierChoice"}}</button> --}}
    </div>
  </div>

  {{! Modifiers }}
  <div class='form-group-stacked'>
    {{#each data.modifiers}}
      <label class='checkbox' title='{{description}}'>
        {{> checkboxControl value=active editable=true inputClass='item-modifier'
          dataValue=value ariaLabel=label}}
        {{label}}
      </label>
    {{/each}}
  </div>

  {{! ================================================== }}

  <hr />

  {{! Max Pushes }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.MaxPush'}}</label>
    <input type='number' name='maxPush' value='{{data.maxPush}}' min='0' data-dtype='Number' />
  </div>

  {{! ================================================== }}

  <hr />

  {{! Roll Mode }}
  <div class='form-group'>
    <label>{{localize 'YZEGS.Dialog.Roll.RollMode'}}</label>
    <select name='messageMode'>
      {{selectOptions config.messageModes selected=data.messageMode localize=true}}
    </select>
  </div>

</div>
