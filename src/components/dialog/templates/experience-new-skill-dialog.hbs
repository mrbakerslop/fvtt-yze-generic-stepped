<div class="experience-dialog experience-new-skill-dialog">
  <p>{{localize "YZEGS.Experience.NewSkillInstructions"}}</p>
  <p class="hint">{{localize "YZEGS.Experience.SpendingTimingReminder"}}</p>

  <div class="form-group">
    <label>{{localize "YZEGS.Skill"}}</label>
    {{> optionMenu name="skill" selected="" options=data.skills editable=true noBlank=true
      menuClass="experience-source-menu"}}
  </div>

  <dl class="experience-dialog-details">
    <dt>{{localize "YZEGS.Experience.TargetRating"}}</dt>
    <dd>D</dd>
    <dt>{{localize "YZEGS.Experience.Cost"}}</dt>
    <dd>{{data.cost}} XP</dd>
    <dt>{{localize "YZEGS.Experience.CurrentXp"}}</dt>
    <dd>{{data.currentXp}} XP</dd>
  </dl>

  {{#unless data.prerequisitesOff}}
  <label class="experience-training-confirmation">
    <input type="hidden" name="experienced" value="false" />
    {{> checkboxControl name="experienced" value=false editable=true}}
    <span>{{localize "YZEGS.Experience.NewSkillExperienceConfirmation"}}</span>
  </label>
  <label class="experience-training-confirmation">
    <input type="hidden" name="trained" value="false" />
    {{> checkboxControl name="trained" value=false editable=true}}
    <span>{{localize "YZEGS.Experience.NewSkillTrainingConfirmation"}}</span>
  </label>
  {{/unless}}

  {{#if data.prerequisiteWarning}}
  <p class="hint warning">{{localize "YZEGS.Experience.NewSkillPrerequisiteWarning"}}</p>
  {{/if}}
</div>
