<div class="combat-grid">

  {{#if impairment.label}}
  <div class="critical-impairment-banner">
    <i class="fa-solid {{#if impairment.dead}}fa-skull{{else}}fa-person-falling{{/if}}"></i>
    <strong>{{impairment.label}}</strong>
  </div>
  {{/if}}

  {{!-- COMBAT --}}
  <div class="combat">
    <h2>{{localize "YZEGS.ActorSheet.Combat"}}</h2>

    {{!-- CUF & Unit Morale --}}
    <div class="stat-block">

      {{!-- Stat Block: Header line --}}
      <div class="stat-header flexrow">
        <div class="col-6"></div>
        <div class="col-3 header-rating">
          <h5>{{localize "YZEGS.ActorSheet.Rating"}}</h5>
        </div>
        <div class="col-3 header-die">
          <h5>{{localize "YZEGS.ActorSheet.BaseDie"}}</h5>
        </div>
      </div>

      {{!-- Coolness Under Fire --}}
      <div class="stat stat-cuf flexrow" data-type="cuf">
        <div class="col-6 stat-name">
          <h4><a class="button cuf-roll">{{localize "YZEGS.ActorSheet.CuF"}}</a></h4>
        </div>
        <div class="col-3 stat-score">
          {{> scoreSelector name="system.cuf.score" selected=system.cuf.score editable=@root.editable}}
        </div>
        <div class="col-3 stat-value">
          {{#if (lte system.cuf.value 0)}}–
          {{else}}
          <div class="boxed-value cuf-roll rollable">D{{system.cuf.value}}</div>
          {{/if}}
        </div>
      </div>

      {{!-- Unit Morale --}}
      {{#if unitMoraleEnabled}}
      <div class="stat stat-unit-morale flexrow" data-type="unit">
        <div class="col-6 stat-name">
          <h4><a class="button unit-morale-roll">{{localize "YZEGS.ActorSheet.UnitMorale"}}</a></h4>
        </div>
        <div class="col-3 stat-score">
          {{> scoreSelector name="system.unitMorale.score" selected=system.unitMorale.score editable=@root.editable}}
        </div>
        <div class="col-3 stat-value">
          {{#if (lte system.unitMorale.value 0)}}–
          {{else}}
          <div class="boxed-value unit-morale-roll rollable">D{{system.unitMorale.value}}</div>
          {{/if}}
        </div>
      </div>
      {{/if}}

    </div>

  </div>

  {{!-- ACTIONS --}}
  <div class="action">
    <h2>
      <span>{{localize "YZEGS.ActorSheet.Actions"}}</span>
      {{#if editable}}
      <button type="button" class="take-action-button" data-action="takeAction"
        title="{{localize 'YZEGS.CombatActions.TakeAction'}}" aria-label="{{localize 'YZEGS.CombatActions.TakeAction'}}">
        <i class="fa-solid fa-person-running"></i> {{localize "YZEGS.CombatActions.TakeAction"}}
      </button>
      {{/if}}
    </h2>

    {{!-- Header line --}}
    <div class="action-header">
      <h5 class="header-current">{{localize "YZEGS.ActorSheet.Current"}}</h5>
      <h5 class="header-max">{{localize "YZEGS.ActorSheet.Max"}}</h5>
    </div>

    {{!-- Slow & Fast --}}
    {{#each system.actions as | action name |}}
    <div class="action-row">
      <div class="action-name">{{localize (concat "YZEGS.ActionTypes." name)}}</div>
      <div class="action-slider">
        <input type="range" name="system.actions.{{name}}.value" min="0" max="{{action.max}}" value="{{action.value}}"/>
      </div>
      <div class="action-value">{{action.value}}</div>
      <div class="action-max">
        <input type="number" name="system.actions.{{name}}.max" value="{{action.max}}"/>
      </div>
    </div>
    {{/each}}
  </div>

</div>

<div class="combat-secondary-grid" data-actor-type="{{actor.type}}">

  {{!-- ARMOR --}}
  <div class="armor">
    <h2>{{localize "YZEGS.ItemTypes.armor"}}</h2>
    <div class="flexcol">
      {{#each system.armorRating as | value location |}}
      <div class="flexrow">
        <div class="col-3">
          <h4>{{localize (concat "YZEGS.ArmorLocationNames." location)}}</h4>
        </div>
        <div class="armor-names-list">
          {{!-- {{#each ../armors as | armor |}}
          {{#if (lookup armor.system.location location)}}
          {{armor.name}},
          {{/if}}
          {{/each}} --}}
        </div>
        <div class="col-1">{{value}}</div>
      </div>
      {{else}}
      <p class="no-armor">{{localize "YZEGS.ActorSheet.NoArmor"}}</p>
      {{/each}}
    </div>
  </div>

  {{!-- CONDITIONS --}}
  {{#if (eq actor.type 'character')}}
  <div class="conditions">
    <h2>{{localize "YZEGS.ActorSheet.Conditions"}}</h2>
    <div class="flexrow">
      {{#each system.conditions as | value condition |}}
      <div class="col-6">
        <label class="checkbox condition-checkbox">
          {{!-- <h4>{{localize (concat "YZEGS.ActorSheet.ConditionNames." condition)}}</h4> --}}
          {{> checkboxControl name=(concat "system.conditions." condition) value=value editable=@root.editable}}
          <span class="condition-label">{{localize (concat "YZEGS.ConditionNames." condition)}}</span>
          {{#if (and (eq condition "hypothermic") value)}}
          <button type="button" class="hypothermia-check" title="{{localize 'YZEGS.Hazards.RollHypothermia'}}">
            <i class="fa-solid fa-dice"></i>
          </button>
          {{/if}}
        </label>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{!-- CRITICAL INJURIES --}}
  {{#if (or (eq actor.type 'character') (eq actor.type 'npc'))}}
  <div class="critical-injuries">
    <h2 class="injuries-title">
      <span>{{localize "YZEGS.ActorSheet.CriticalInjuries"}}</span>
      <span class="item-controls">
        <a class="button item-create" data-type="injury" title="{{localize "YZEGS.ActorSheet.AddInjury"}}">
          {{{config.Icons.buttons.plus}}}
        </a>
      </span>
    </h2>
    <div class="injuries-list">
      {{#each criticalInjuries}}
      <div class="item injury" data-item-id="{{id}}">
        <div class="injury-summary">
          <a class="item-edit"><span class="injury-name">{{name}}</span></a>
          {{#if lethal}}<span class="injury-lethal">{{localize "YZEGS.Critical.Lethal"}}</span>{{/if}}
          {{#if deadline}}<span class="injury-deadline">{{deadline}}</span>{{/if}}
          {{#if healingDays}}<span class="injury-healing">{{localize "YZEGS.Critical.HealingDays" days=healingDays}}</span>{{/if}}
          {{#if treatmentActive}}<span class="injury-treatment">
            {{localize "YZEGS.Critical.TreatmentBy" name=treatmentHealer}}</span>{{/if}}
        </div>
        <span class="injury-actions">
          {{#if due}}
          <button type="button" class="critical-death-save" title="{{localize 'YZEGS.Critical.RollDeathSave'}}">
            <i class="fa-solid fa-dice"></i>
          </button>
          {{/if}}
          {{#if lethal}}
            {{#unless instantDeath}}{{#unless stabilized}}
              {{#if canResolveTreatment}}
              <button type="button" class="critical-resolve-treatment" title="{{localize 'YZEGS.Critical.ResolveTreatment'}}">
                <i class="fa-solid fa-notes-medical"></i>
              </button>
              {{else}}
                {{#unless treatmentActive}}
                {{#unless stabilizationLocked}}
                <button type="button" class="critical-stabilize" title="{{localize 'YZEGS.Critical.Stabilize'}}">
                  <i class="fa-solid fa-kit-medical"></i>
                </button>
                {{/unless}}
                {{/unless}}
              {{/if}}
            {{/unless}}{{/unless}}
          {{/if}}
        </span>
        <a class="btn btn-small item-delete" title="{{localize "YZEGS.ActorSheet.Delete"}}">
          {{{@root.config.Icons.buttons.delete}}}
        </a>
      </div>
      {{else}}
      <div class="no-injury">—</div>
      {{/each}}
    </div>
  </div>
  {{/if}}

{{#if (or (eq actor.type 'character') (eq actor.type 'npc'))}}
<div class="disease-items">
  <h2 class="diseases-title">
    <span>{{localize "YZEGS.ActorSheet.Diseases"}}</span>
    <span class="item-controls">
      <a class="button item-create" data-type="disease" title="{{localize 'YZEGS.Disease.Add'}}">
        {{{config.Icons.buttons.plus}}}
      </a>
    </span>
  </h2>
  <div class="diseases-list">
    {{#each diseaseItems}}
    <div class="item disease" data-item-id="{{id}}">
      <div class="disease-summary">
        <a class="item-edit"><strong>{{name}}</strong></a>
        <span class="disease-phase">{{phaseLabel}}</span>
        {{#if antibioticsUsed}}<span><i class="fa-solid fa-pills"></i> {{localize "YZEGS.Disease.AntibioticsUsed"}}</span>{{/if}}
        {{#if caregiverName}}<span>{{localize "YZEGS.Disease.TreatedBy" name=caregiverName}}</span>{{/if}}
      </div>
      <span class="disease-actions">
        {{#unless recovered}}
        <button type="button" class="disease-check {{#if due}}due{{/if}}" title="{{localize 'YZEGS.Disease.RollCheck'}}">
          <i class="fa-solid fa-dice"></i>
        </button>
        <button type="button" class="disease-treat" title="{{localize 'YZEGS.Disease.Treat'}}">
          <i class="fa-solid fa-user-doctor"></i>
        </button>
        {{/unless}}
      </span>
      <a class="btn btn-small item-delete" title="{{localize 'YZEGS.ActorSheet.Delete'}}">
        {{{@root.config.Icons.buttons.delete}}}
      </a>
    </div>
    {{else}}
    <div class="no-disease">—</div>
    {{/each}}
  </div>
</div>
{{/if}}

</div>

{{!-- RADIATION --}}
{{#if (eq actor.type 'character')}}
{{#if radiation.enabled}}
<div class="radiation">
  <h2><a class="radiation-roll">{{radiation.name}}</a></h2>
  <div class="flexrow">
    <div>
      <h3>{{localize "YZEGS.ActorSheet.TemporaryRadiation"}}</h3>
      {{> "systems/fvtt-yze-generic-stepped/templates/actor/parts/radiation-boxes.hbs" field="temporary" value=system.rads.temporary}}
    </div>
    <div>
      <h3>{{localize "YZEGS.ActorSheet.PermanentRadiation"}}</h3>
      {{> "systems/fvtt-yze-generic-stepped/templates/actor/parts/radiation-boxes.hbs" field="permanent" value=system.rads.permanent}}
    </div>
  </div>
</div>
{{/if}}
{{/if}}
