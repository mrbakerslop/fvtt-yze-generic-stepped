<div class="combat-grid">

  {{!-- COMBAT --}}
  <div class="combat">
    <h2>{{localize "YZEGS.ActorSheet.Combat"}}</h2>

    {{!-- CUF & Unit Morale --}}
    <div class="stat-block">

      {{!-- Stat Block: Header line --}}
      <div class="stat-header flexrow">
        <div class="col-6"></div>
        <div class="col-3 header-rating">
          <h5>{{localize "YZEGS.ActorSheet.Rating"}}</h5>
        </div>
        <div class="col-3 header-die">
          <h5>{{localize "YZEGS.ActorSheet.BaseDie"}}</h5>
        </div>
      </div>

      {{!-- Coolness Under Fire --}}
      <div class="stat stat-cuf flexrow" data-type="cuf">
        <div class="col-6 stat-name">
          <h4><a class="button cuf-roll">{{localize "YZEGS.ActorSheet.CuF"}}</a></h4>
        </div>
        <div class="col-3 stat-score">
          {{> scoreSelector name="system.cuf.score" selected=system.cuf.score editable=@root.editable}}
        </div>
        <div class="col-3 stat-value">
          {{#if (lte system.cuf.value 0)}}–
          {{else}}
          <div class="boxed-value cuf-roll rollable">D{{system.cuf.value}}</div>
          {{/if}}
        </div>
      </div>

      {{!-- Unit Morale --}}
      <div class="stat stat-unit-morale flexrow" data-type="unit">
        <div class="col-6 stat-name">
          <h4><a class="button unit-morale-roll">{{localize "YZEGS.ActorSheet.UnitMorale"}}</a></h4>
        </div>
        <div class="col-3 stat-score">
          {{> scoreSelector name="system.unitMorale.score" selected=system.unitMorale.score editable=@root.editable}}
        </div>
        <div class="col-3 stat-value">
          {{#if (lte system.unitMorale.value 0)}}–
          {{else}}
          <div class="boxed-value unit-morale-roll rollable">D{{system.unitMorale.value}}</div>
          {{/if}}
        </div>
      </div>

    </div>

  </div>

  {{!-- ACTIONS --}}
  <div class="action">
    <h2>{{localize "YZEGS.ActorSheet.Actions"}}</h2>

    {{!-- Header line --}}
    <div class="action-header">
      <h5 class="header-current">{{localize "YZEGS.ActorSheet.Current"}}</h5>
      <h5 class="header-max">{{localize "YZEGS.ActorSheet.Max"}}</h5>
    </div>

    {{!-- Slow & Fast --}}
    {{#each system.actions as | action name |}}
    <div class="action-row">
      <div class="action-name">{{localize (concat "YZEGS.ActionTypes." name)}}</div>
      <div class="action-slider">
        <input type="range" name="system.actions.{{name}}.value" min="0" max="{{action.max}}" value="{{action.value}}"/>
      </div>
      <div class="action-value">{{action.value}}</div>
      <div class="action-max">
        <input type="number" name="system.actions.{{name}}.max" value="{{action.max}}"/>
      </div>
    </div>
    {{/each}}
  </div>

</div>

<div class="combat-secondary-grid" data-actor-type="{{actor.type}}">

  {{!-- ARMOR --}}
  <div class="armor">
    <h2>{{localize "YZEGS.ItemTypes.armor"}}</h2>
    <div class="flexcol">
      {{#each system.armorRating as | value location |}}
      <div class="flexrow">
        <div class="col-3">
          <h4>{{localize (concat "YZEGS.ArmorLocationNames." location)}}</h4>
        </div>
        <div class="armor-names-list">
          {{!-- {{#each ../armors as | armor |}}
          {{#if (lookup armor.system.location location)}}
          {{armor.name}},
          {{/if}}
          {{/each}} --}}
        </div>
        <div class="col-1">{{value}}</div>
      </div>
      {{else}}
      <p class="no-armor">{{localize "YZEGS.ActorSheet.NoArmor"}}</p>
      {{/each}}
    </div>
  </div>

  {{!-- CONDITIONS --}}
  {{#if (eq actor.type 'character')}}
  <div class="conditions">
    <h2>{{localize "YZEGS.ActorSheet.Conditions"}}</h2>
    <div class="flexrow">
      {{#each system.conditions as | value condition |}}
      <div class="col-6">
        <label class="checkbox condition-checkbox">
          {{!-- <h4>{{localize (concat "YZEGS.ActorSheet.ConditionNames." condition)}}</h4> --}}
          {{> checkboxControl name=(concat "system.conditions." condition) value=value editable=@root.editable}}
          <span class="condition-label">{{localize (concat "YZEGS.ConditionNames." condition)}}</span>
        </label>
      </div>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{!-- CRITICAL INJURIES --}}
  {{#if (eq actor.type 'character')}}
  <div class="critical-injuries">
    <h2 class="injuries-title">
      <span>{{localize "YZEGS.ActorSheet.CriticalInjuries"}}</span>
      <span class="item-controls">
        <a class="button item-create" data-type="injury" title="{{localize "YZEGS.ActorSheet.AddInjury"}}">
          {{{config.Icons.buttons.plus}}}
        </a>
      </span>
    </h2>
    <div class="injuries-list">
      {{#each actor.itemTypes.injury}}
      <div class="item injury" data-item-id="{{id}}">
        <a class="item-edit">
          <span class="injury-name">{{name}}</span>
        </a>
        <a class="btn btn-small item-delete" title="{{localize "YZEGS.ActorSheet.Delete"}}">
          {{{@root.config.Icons.buttons.delete}}}
        </a>
      </div>
      {{else}}
      <div class="no-injury">—</div>
      {{/each}}
    </div>
  </div>
  {{/if}}

</div>

{{#if (eq actor.type 'character')}}
<div class="combat-details flexcol">
  <h3 class="diseases-title">{{localize "YZEGS.ActorSheet.Diseases"}}</h3>
  <textarea name="system.diseases" rows="2">{{system.diseases}}</textarea>
</div>
{{/if}}

{{!-- RADIATION --}}
{{#if (eq actor.type 'character')}}
<div class="radiation">
  <h2><a class="radiation-roll">{{localize "YZEGS.ActorSheet.Radiation"}}</a></h2>
  <div class="flexrow">
    <div>
      <h3>{{localize "YZEGS.ActorSheet.TemporaryRadiation"}}</h3>
      {{> "systems/fvtt-yze-generic-stepped/templates/actor/parts/radiation-boxes.hbs" field="temporary" value=system.rads.temporary}}
    </div>
    <div>
      <h3>{{localize "YZEGS.ActorSheet.PermanentRadiation"}}</h3>
      {{> "systems/fvtt-yze-generic-stepped/templates/actor/parts/radiation-boxes.hbs" field="permanent" value=system.rads.permanent}}
    </div>
  </div>
</div>
{{/if}}
