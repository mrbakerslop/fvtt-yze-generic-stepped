{
  "name": "fvtt-yze-generic-stepped",
  "version": "14.0.9",
  "private": true,
  "description": "A generic Foundry VTT system for Year Zero Engine games using stepped dice",
  "author": {
    "name": "MrBaker",
    "url": "https://github.com/mrbakerslop"
  },
  "homepage": "https://github.com/mrbakerslop/fvtt-yze-generic-stepped",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrbakerslop/fvtt-yze-generic-stepped.git"
  },
  "bugs": {
    "url": "https://github.com/mrbakerslop/fvtt-yze-generic-stepped/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "GPL-3.0-or-later",
  "keywords": [
    "Foundry",
    "VTT",
    "Year Zero Engine",
    "stepped dice",
    "YZE",
    "RPG",
    "TTRPG",
    "Roleplaying Game",
    "Tabletop Roleplaying Game"
  ],
  "main": "src/yzegs.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development gulp build",
    "dev:watch": "cross-env NODE_ENV=development gulp watch",
    "build": "cross-env NODE_ENV=production gulp build",
    "link": "node ./tools/link-project.js",
    "link:force": "node ./tools/link-project.js --force",
    "clean": "gulp clean",
    "bump": "cross-env NODE_ENV=production npm run lint:fix && gulp bump --r",
    "lint": "eslint --ext .js .",
    "lint:fix": "eslint --ext .js --fix .",
    "format": "prettier-eslint \"**/*.js\" --write",
    "format:hbs": "prettier-eslint **/*.hbs --write --parser=glimmer",
    "postinstall": "husky install && patch-package",
    "upd": "npm list -g --depth=0 & npm outdated & npx npm-check -u",
    "test": "npm run test:unit && npm run lint && npm run build",
    "test:unit": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.34",
    "@typhonjs-fvtt/eslint-config-foundry.js": "0.8.0",
    "chalk": "^5.6.2",
    "cross-env": "7.0.3",
    "devmoji": "2.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.47.0",
    "eslint-config-jquery": "^3.0.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra-plus": "^0.6.0",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-less": "^5.0.0",
    "gulp-yaml": "2.0.4",
    "husky": "^8.0.3",
    "less": "^4.8.1",
    "patch-package": "8.0.1",
    "prettier": "^3.9.6",
    "prettier-eslint-cli": "^7.1.0",
    "semver": "^7.8.5"
  }
}
